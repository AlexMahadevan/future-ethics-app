# Add this to your .gitignore to avoid committing sensitive credentials

# Airtable credentials
config.js
config.production.js

# Allow config.js (root and future-ethics-app subfolder) so GitHub Pages
# can read Airtable creds. The PAT is narrowly scoped (write to one base
# only) and is runtime-exposed in browser network requests anyway.
# Rotate it after each workshop.
!/config.js
!future-ethics-app/config.js

# System files
.DS_Store
.vscode/
*.log

# Dependencies (if you add any build tools later)
node_modules/
venv/
